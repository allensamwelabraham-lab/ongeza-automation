# Nakili kuwa .env au weka kama environment variables kabla ya kuendesha tests.
# Credentials za pamoja kwa apps zote:
ONGEZA_USERNAME=admin
ONGEZA_PASSWORD=
# (hiari) credentials tofauti kwa app moja: JUMLA_USERNAME / JUMLA_PASSWORD,
# ONGEZAPRO_USERNAME / ONGEZAPRO_PASSWORD, ONGEZA_STAGING_USERNAME / ONGEZA_STAGING_PASSWORD
# (hiari) badilisha URL:
# JUMLA_URL=https://jumla.ongeza.net
# ONGEZA_URL=https://staging.ongeza.net
# ONGEZAPRO_URL=https://ongezapro.ongeza.net
HEADLESS=0
RUN_CRUD=0
# Project tester (tools/push_to_tester.py). Login inatuma OTP kwa email:
TESTER_API_URL=
TESTER_USERNAME=
TESTER_PASSWORD=
# (hiari) TESTER_OTP= au TESTER_TOKEN= (Sanctum token, inaruka login/OTP)
